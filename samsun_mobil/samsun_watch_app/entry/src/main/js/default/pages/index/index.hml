<div class="container">
    <text class="title">Samair & Ulaşım</text>
    
    <tabs class="tabs">
        <tab-bar class="tab-bar">
            <text class="tab-text">🚌 Yaklaşan</text>
            <text class="tab-text">📍 Git</text>
        </tab-bar>
        
        <tab-content class="tab-content">
            <!-- 1. Sekme: Yaklaşan Araçlar (Live) -->
            <div class="fav-section">
                <text class="subtitle">Durağım: T. Özal Yurdu</text>
                <div class="loading" if="{{isLoading}}">
                    <text class="loading-text">Yükleniyor...</text>
                </div>
                <list class="bus-list" if="{{!isLoading}}">
                    <list-item for="{{buses}}" class="bus-item">
                        <div class="bus-row">
                            <text class="bus-code">{{$item.hatKodu}}</text>
                            <text class="bus-time">{{$item.kalanSure}} dk</text>
                        </div>
                    </list-item>
                </list>
                <text class="empty-msg" if="{{!isLoading && buses.length == 0}}">Araç Yok</text>
                <button class="btn-refresh" onclick="fetchData">Yenile</button>
            </div>
            
            <!-- 2. Sekme: Rota ("Nasıl Giderim?") -->
            <div class="rota-section">
                <text class="subtitle">Meydan -> Çarşamba</text>
                <div class="loading" if="{{isRouting}}">
                    <text class="loading-text">Rota Aranıyor...</text>
                </div>
                
                <list class="bus-list" if="{{!isRouting}}">
                    <list-item for="{{routes}}" class="bus-item" style="height: 120px; flex-direction: column; justify-content: flex-start; align-items: flex-start; padding: 10px;">
                        <!-- Rota Tipi -->
                        <text style="color: {{$item.type === 'DIRECT' ? '#2ecc71' : '#f39c12'}}; font-size: 14px; font-weight: bold;">
                            {{$item.type === 'DIRECT' ? '✅ Doğrudan' : '⚠️ Aktarmalı'}}
                        </text>
                        <!-- Puan / Süre bilgisi -->
                        <text style="color: #ffffff; font-size: 12px; margin-top: 5px;">
                            Puan: {{$item.total_score}}
                        </text>
                        <!-- Polyline Göstergesi -->
                        <div style="margin-top: 5px; background-color: #34495e; border-radius: 5px; padding: 2px 5px;" if="{{$item.polyline && $item.polyline.length > 0}}">
                            <text style="color: #3498db; font-size: 10px;">🗺️ {{$item.polyline.length}} Koordinat Çizildi</text>
                        </div>
                    </list-item>
                </list>
                
                <text class="empty-msg" if="{{!isRouting && routes.length == 0}}">Rota Bulunamadı</text>
                <button class="btn-refresh" onclick="fetchRoute">Hesapla</button>
            </div>
            
        </tab-content>
    </tabs>
</div>
